# Postgres connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitron"

# Daily jobs: a scheduler calls GET /api/jobs/daily with "Authorization: Bearer <CRON_SECRET>" each morning
CRON_SECRET=""

# WhatsApp Cloud API (Settings > WhatsApp > "Official Cloud API").
# Webhook URL for Meta: https://<your-domain>/api/webhooks/whatsapp
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# Linked-phone connector (Settings > WhatsApp > "Linked phone")
WA_CONNECTOR_URL=""
WA_CONNECTOR_KEY=""

# Razorpay UPI Autopay (Settings > UPI Autopay > "Live").
# Webhook URL for Razorpay: https://<your-domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Fitron AI (the assistant on /ai). Without a key the brief and risk list still work.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
